{% doc %}
  @prompt
    Create a NEW homepage editorial book block highlighting Sarah Bloom’s Stop Forcing Start Becoming. Use the actual full book-cover image already uploaded to the store at https://cdn.shopify.com/s/files/1/0065/6487/2280/files/sarah-bloom-full-cover.png?v=1791754585 as the default cover, not a placeholder. Provide an editable image picker. Show the entire cover without cropping, preserving its portrait proportions. Use a solid black background, white typography, restrained gold accents inspired by the cover, and a refined magazine-style layout. Make the book image prominent beside the title, author, subtitle ‘Build Effortless Habits by Rewiring Your Identity’, and a small ‘Featured read’ label. Include an editable neutral introduction, no invented quotations or claims about book contents. Add an ‘Explore the book’ button linking to https://books.google.com/books?id=L8XCEQAAQBAJ . Use spacious desktop layout and stack neatly on mobile. Keep background and text colors editable within this block rather than relying only on the parent section color scheme. Create this as a separate new block, leaving the existing editorial feature unchanged.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-book-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: clamp(32px, 6vw, 88px) clamp(22px, 6vw, 84px);
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-book-editorial-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(220px, 0.82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: clamp(36px, 8vw, 112px);
    max-width: 1180px;
    margin: 0 auto;
  }

  .ai-book-editorial-{{ ai_gen_id }}__cover-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    min-width: 0;
  }

  .ai-book-editorial-{{ ai_gen_id }}__cover {
    display: block;
    width: min(100%, 390px);
    height: auto;
    object-fit: contain;
    box-shadow: 0 24px 54px rgba(0, 0, 0, 0.42);
  }

  .ai-book-editorial-{{ ai_gen_id }}__cover-placeholder {
    width: min(100%, 390px);
    aspect-ratio: 2 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #171717;
  }

  .ai-book-editorial-{{ ai_gen_id }}__cover-placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    color: #777;
  }

  .ai-book-editorial-{{ ai_gen_id }}__copy {
    max-width: 620px;
  }

  .ai-book-editorial-{{ ai_gen_id }}__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 24px;
    color: {{ block.settings.accent_color }};
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ai-book-editorial-{{ ai_gen_id }}__eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
  }

  .ai-book-editorial-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(36px, 5vw, 68px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .ai-book-editorial-{{ ai_gen_id }}__author {
    margin: 18px 0 0;
    color: {{ block.settings.text_color }};
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.4;
  }

  .ai-book-editorial-{{ ai_gen_id }}__subtitle {
    margin: 8px 0 0;
    color: {{ block.settings.accent_color }};
    font-size: 14px;
    line-height: 1.6;
  }

  .ai-book-editorial-{{ ai_gen_id }}__rule {
    width: 54px;
    height: 1px;
    margin: 28px 0 22px;
    border: 0;
    background: {{ block.settings.accent_color }};
  }

  .ai-book-editorial-{{ ai_gen_id }}__intro {
    max-width: 490px;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.75;
  }

  .ai-book-editorial-{{ ai_gen_id }}__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 32px;
    padding: 12px 24px;
    border: 1px solid {{ block.settings.accent_color }};
    background: transparent;
    color: {{ block.settings.text_color }};
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .ai-book-editorial-{{ ai_gen_id }}__action:hover {
    background: {{ block.settings.accent_color }};
    color: {{ block.settings.background_color }};
  }

  .ai-book-editorial-{{ ai_gen_id }}__action:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-book-editorial-{{ ai_gen_id }} {
      padding: 36px 22px;
    }

    .ai-book-editorial-{{ ai_gen_id }}__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-book-editorial-{{ ai_gen_id }}__cover {
      width: min(72%, 320px);
    }

    .ai-book-editorial-{{ ai_gen_id }}__cover-placeholder {
      width: min(72%, 320px);
    }

    .ai-book-editorial-{{ ai_gen_id }}__copy {
      text-align: center;
      margin: 0 auto;
    }

    .ai-book-editorial-{{ ai_gen_id }}__eyebrow {
      justify-content: center;
      margin-bottom: 18px;
    }

    .ai-book-editorial-{{ ai_gen_id }}__rule {
      margin-inline: auto;
    }

    .ai-book-editorial-{{ ai_gen_id }}__action {
      margin-top: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-book-editorial-{{ ai_gen_id }}__action {
      transition: none;
    }
  }
{% endstyle %}

<div class="ai-book-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-book-editorial-{{ ai_gen_id }}__inner">
    <div class="ai-book-editorial-{{ ai_gen_id }}__cover-wrap">
      {% if block.settings.cover_image != blank %}
        <img
          class="ai-book-editorial-{{ ai_gen_id }}__cover"
          src="{{ block.settings.cover_image | image_url: width: 1000 }}"
          alt="{{ block.settings.cover_image.alt | default: 'Cover of Stop Forcing Start Becoming by Sarah Bloom' | escape }}"
          width="{{ block.settings.cover_image.width }}"
          height="{{ block.settings.cover_image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="ai-book-editorial-{{ ai_gen_id }}__cover-placeholder">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
    <div class="ai-book-editorial-{{ ai_gen_id }}__copy">
      <p class="ai-book-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.label | escape }}</p>
      <h2 class="ai-book-editorial-{{ ai_gen_id }}__title">{{ block.settings.book_title | escape }}</h2>
      <p class="ai-book-editorial-{{ ai_gen_id }}__author">{{ block.settings.author | escape }}</p>
      <p class="ai-book-editorial-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle | escape }}</p>
      <hr class="ai-book-editorial-{{ ai_gen_id }}__rule">
      <div class="ai-book-editorial-{{ ai_gen_id }}__intro">{{ block.settings.introduction | escape | newline_to_br }}</div>
      <a class="ai-book-editorial-{{ ai_gen_id }}__action" href="{{ block.settings.button_link }}" target="_blank" rel="noopener noreferrer">
        {{ block.settings.button_label | escape }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial book feature",
  "settings": [
    {
      "type": "header",
      "content": "Book details"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Book cover"
    },
    {
      "type": "text",
      "id": "book_title",
      "label": "Title",
      "default": "Stop Forcing Start Becoming"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "Sarah Bloom"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Build Effortless Habits by Rewiring Your Identity"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Feature label",
      "default": "Featured read"
    },
    {
      "type": "textarea",
      "id": "introduction",
      "label": "Introduction",
      "default": "Discover Stop Forcing Start Becoming by Sarah Bloom, a book for your reading list."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the book"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold accent",
      "default": "#D6B66A"
    }
  ],
  "presets": [
    {
      "name": "Editorial book feature"
    }
  ],
  "tag": null,
  "class": "editorial-book-feature"
}
{% endschema %}